# Copy to .streamlit/secrets.toml (git-ignored) or paste into the host's secrets
# settings. Every value here is a placeholder.

# ---------------------------------------------------------------------------
# Who may use live data (required for anything other than Demo Mode)
# ---------------------------------------------------------------------------

# Only these signed-in addresses can reach the connectors, Supabase, the
# model API key and the Slack webhook configured below. Everyone else, signed
# in or not, is limited to Demo Mode. With this list missing or empty, nobody
# has live access.
allowed_emails = [
    "REPLACE_WITH_USER_EMAIL",
]

# ---------------------------------------------------------------------------
# Integrations (all optional; an unset connector falls back to manual upload)
# ---------------------------------------------------------------------------

# ANTHROPIC_API_KEY = "REPLACE_WITH_ANTHROPIC_API_KEY"

# Use the service-role key: after db/migrations_002_enable_rls.sql the anon
# key can no longer read or write the tables. The key stays on the server.
# SUPABASE_URL = "REPLACE_WITH_SUPABASE_PROJECT_URL"
# SUPABASE_KEY = "REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY"

# SLACK_WEBHOOK_URL = "REPLACE_WITH_SLACK_WEBHOOK_URL"

# Okta: the org's own Okta domain (custom domains are not accepted) and a
# read-only admin's API token.
# OKTA_DOMAIN    = "REPLACE_WITH_ORG.okta.com"
# OKTA_API_TOKEN = "REPLACE_WITH_OKTA_API_TOKEN"

# The other connectors read: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_REGION, AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET,
# GCP_SERVICE_ACCOUNT_JSON, GOOGLE_SERVICE_ACCOUNT_JSON, GITHUB_TOKEN,
# GITHUB_ORG, JIRA_BASE_URL, JIRA_EMAIL, JIRA_API_TOKEN, CONFLUENCE_BASE_URL,
# CONFLUENCE_EMAIL, CONFLUENCE_API_TOKEN, JAMF_BASE_URL, JAMF_CLIENT_ID,
# JAMF_CLIENT_SECRET, INTUNE_TENANT_ID, INTUNE_CLIENT_ID, INTUNE_CLIENT_SECRET,
# KANDJI_BASE_URL, KANDJI_API_TOKEN.

# ---------------------------------------------------------------------------
# Sign-in (required for live data on any deployment other people can reach)
# ---------------------------------------------------------------------------

# Streamlit's own OIDC sign-in (st.login); see
# https://docs.streamlit.io/develop/api-reference/user/st.login
# TOML tables must come last, so keep this section at the end of the file.
#
# Local use without an identity provider: run
#   SOC2_DEV_LOGIN_EMAIL=you@example.com streamlit run app.py --server.address localhost
# The variable is ignored unless the server is bound to localhost.
[auth]
redirect_uri = "REPLACE_WITH_APP_URL/oauth2callback"
cookie_secret = "REPLACE_WITH_LONG_RANDOM_STRING"
client_id = "REPLACE_WITH_OIDC_CLIENT_ID"
client_secret = "REPLACE_WITH_OIDC_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
